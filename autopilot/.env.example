# Copy to .env (and keep it out of git). Both secrets must be long and random,
# e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared only between n8n and this Flask app — authenticates the /api/* routes.
N8N_SECRET=

# Signs preview/approve/reject tokens. Must be different from N8N_SECRET.
HMAC_SECRET=

# Optional overrides
AUTOPILOT_DB_PATH=
AUTOPILOT_PORT=8001
FLASK_DEBUG=0
